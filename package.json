{
  "name": "course-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.13.0",
    "zod": "^3.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "oidc-client-ts": "^3.0.0",
    "fflate": "0.8.2",
    "fast-xml-parser": "^5.3.0",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^6.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.11.0",
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.56.0"
  }
}
